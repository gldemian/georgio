{
  // Static-assets-only Worker serving the Vite build at bodyby.georgedemian.com
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bodyby",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "bodyby.georgedemian.com", "custom_domain": true }
  ]
}
